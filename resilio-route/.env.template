# ── Resilio-Route Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database
DATABASE_URL=postgresql://resilio:password@localhost:5432/resilio_route

# API keys
CLOUD_API_KEY=rr_live_xxxxxxxxxxxx
CLOUD_API_BASE_URL=http://localhost:8001
NHIDCL_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ML model settings
MODEL_VERSION=0.1.0
RED_THRESHOLD=0.70
YELLOW_THRESHOLD=0.40
ALERT_LEAD_TIME_MIN=30

# Node network
LORA_FREQUENCY=865.0
SAMPLE_INTERVAL_SEC=300
GATEWAY_UPLINK_INTERVAL_SEC=60

# Soil parameters (update from site survey)
SOIL_COHESION_KPA=8.0
SOIL_FRICTION_DEG=28.0
SOIL_UNIT_WEIGHT=19.0
SOIL_FAILURE_DEPTH_M=1.5

# Satellite backup (Iridium SBD)
IRIDIUM_SBD_ENDPOINT=https://directip.iridium.com/

# Environment
APP_ENV=development      # development | staging | production
LOG_LEVEL=INFO
